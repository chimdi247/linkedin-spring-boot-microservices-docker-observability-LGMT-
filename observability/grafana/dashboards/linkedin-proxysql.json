{
  "uid": "linkedin-proxysql",
  "title": "ProxySQL",
  "description": "Pooling and read/write splitting. Metrics come from SQL against ProxySQL's stats schema (collector sqlquery receiver).",
  "tags": [
    "linkedin",
    "mysql",
    "proxysql"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "links": [
    {
      "type": "dashboards",
      "title": "LinkedIn dashboards",
      "tags": [
        "linkedin"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "text",
      "title": "Notes",
      "options": {
        "mode": "markdown",
        "content": "Counters (`Questions`, `Com_*`, ...) are cumulative values stored as gauges -> use `rate()`. Hostgroup **10** = writer (primary), **20** = readers (replica + primary fail-safe). **Waiting clients** has no native ProxySQL statistic: the panel is an *approximation* (idle client sessions and pool `get_conn_failure` rate)."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Status & connections",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Status",
      "description": "Series exists = collector can query the admin interface (no data = DOWN).",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "clamp_max(count(proxysql_global{variable_name=\"ProxySQL_Uptime\"}) , 1)",
          "legendFormat": "",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d62728",
                "value": null
              },
              {
                "color": "#2ca02c",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "#d62728"
                },
                "1": {
                  "text": "UP",
                  "color": "#2ca02c"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "id": 3,
