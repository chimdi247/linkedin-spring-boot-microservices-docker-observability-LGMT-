[mysqld]
server-id                      = 1
log-bin                        = mysql-bin
binlog_format                  = ROW
gtid_mode                      = ON
enforce_gtid_consistency       = ON
binlog_expire_logs_seconds     = 604800
default_authentication_plugin  = mysql_native_password
character-set-server           = utf8mb4
max_connections                = 300
innodb_buffer_pool_size        = 256M
performance_schema             = ON
slow_query_log                 = ON
long_query_time                = 1
skip-name-resolve
