    {
      "type": "timeseries",
      "title": "Pool utilisation %",
      "description": "used / (used + free) of the connections currently open to each backend.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "100 * sum by (hostgroup, srv_host) (proxysql_connpool_conn_used) / clamp_min(sum by (hostgroup, srv_host) (proxysql_connpool_conn_used) + sum by (hostgroup, srv_host) (proxysql_connpool_conn_free), 1)",
          "legendFormat": "hg{{hostgroup}} {{srv_host}}",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
