# ---------------------------------------------------------------------------
# Copy to .env  (cp .env.example .env)  and change the secrets for anything but local use.
# docker compose reads .env automatically; every value also has a default in docker-compose.yml.
# ---------------------------------------------------------------------------

# Public URL of the SPA as the BROWSER sees it (used for uploaded-image URLs: <base>/media/...)
PUBLIC_BASE_URL=http://136.71.169.139:3000

# JWT signing secret: base64, >= 32 bytes (shared by user-service and api-gateway).  openssl rand -base64 48
JWT_SECRET=/LhWREsbkXcas1jN78GjtH/rhggZ6q24AdPd6UUoj4uQo+Jz3fArAUKypvs2prdI

# ---- MySQL (primary + replica behind ProxySQL) ----
MYSQL_ROOT_PASSWORD=rootpass
REPLICATION_PASSWORD=replpass
PROXYSQL_MONITOR_PASSWORD=monitorpass
PROXYSQL_ADMIN_PASSWORD=radminpass
APP_RW_PASSWORD=apprwpass
APP_RO_PASSWORD=appropass
EXPORTER_PASSWORD=exporterpass

# ---- S3 storage (MinIO locally). For AWS: S3_ENDPOINT empty, real keys, region and bucket names ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_REGION=us-east-1
MEDIA_BUCKET=linkedin-media

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- Alerting e-mail (Grafana-managed alerts, CPU/memory > 40 %) ----
# Default SMTP is Mailpit (catches all mail, UI at http://localhost:8025). For a real server set host/user/password.
ALERT_EMAIL_TO=shimdi247@gmail.com
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=chimdi247@gmail.com
SMTP_PASSWORD=
SMTP_FROM=grafana-alerts@example.com
SMTP_STARTTLS_POLICY=MandatoryStartTLS
# Containers the CPU / memory alert rules look at (regex on the container name). Default = every container.
ALERT_CONTAINER_REGEX=.+

# ---- Host ports ----
FRONTEND_PORT=3000
GATEWAY_PORT=8080
GRAFANA_PORT=3001
KAFKA_UI_PORT=8090
REDIS_UI_PORT=8091
MINIO_CONSOLE_PORT=9001
MAILPIT_PORT=8025
MYSQL_PORT=3307
PROXYSQL_PORT=6033
