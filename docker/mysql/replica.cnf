[mysqld]
server-id                      = 2
log-bin                        = mysql-bin
log_replica_updates            = ON
relay-log                      = relay-bin
binlog_format                  = ROW
gtid_mode                      = ON
enforce_gtid_consistency       = ON
default_authentication_plugin  = mysql_native_password
character-set-server           = utf8mb4
max_connections                = 300
innodb_buffer_pool_size        = 256M
performance_schema             = ON
skip-name-resolve
# read_only / super_read_only are switched on at the end of replica-init (the image's own
# bootstrap needs to write while it initialises the data directory).
