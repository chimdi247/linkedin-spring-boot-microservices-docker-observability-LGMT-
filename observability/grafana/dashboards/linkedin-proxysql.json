        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "proxysql_global{variable_name=\"Client_Connections_connected\"} - proxysql_global{variable_name=\"Client_Connections_non_idle\"}",
          "legendFormat": "idle client sessions",
          "range": true,
          "editorMode": "code"
